            "header": [ { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" } ],
            "url": {
              "raw": "{{baseUrl}}/accounting/accounts?access_token={{accessToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounting", "accounts"],
              "query": [ { "key": "access_token", "value": "{{accessToken}}" } ]
            }
          }
        },
        {
          "name": "List ledger accounts",
          "request": {
            "method": "GET",
