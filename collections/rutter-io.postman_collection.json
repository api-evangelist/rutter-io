        {
          "name": "Create a journal entry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounting/journal_entries?access_token={{accessToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounting", "journal_entries"],
              "query": [ { "key": "access_token", "value": "{{accessToken}}" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"journal_entry\": {\n    \"transaction_date\": \"2026-07-01\",\n    \"currency_code\": \"USD\",\n    \"line_items\": []\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List invoices",
          "request": {
