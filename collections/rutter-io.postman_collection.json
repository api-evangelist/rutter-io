{
  "info": {
    "name": "Rutter Unified API",
    "description": "Rutter is a unified API for commerce, accounting, and payments. Requests use HTTP Basic auth (client_id:secret), an X-Rutter-Version header, and a connection access_token query parameter for data endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{clientId}}", "type": "string" },
      { "key": "password", "value": "{{secret}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://production.rutterapi.com/versioned" },
    { "key": "rutterVersion", "value": "2023-03-14" },
    { "key": "clientId", "value": "" },
    { "key": "secret", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "publicToken", "value": "" },
    { "key": "connectionId", "value": "" },
    { "key": "webhookId", "value": "" }
  ],
  "item": [
    {
      "name": "Connections",
      "item": [
        {
          "name": "Exchange a public token for an access token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/connections/access_token",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "access_token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"public_token\": \"{{publicToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "List connections",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" } ],
            "url": {
              "raw": "{{baseUrl}}/connections",
              "host": ["{{baseUrl}}"],
              "path": ["connections"]
            }
          }
        },
        {
          "name": "Get a connection",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" } ],
            "url": {
              "raw": "{{baseUrl}}/connections/{{connectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "{{connectionId}}"]
            }
          }
        },
        {
          "name": "Delete a connection",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" } ],
            "url": {
              "raw": "{{baseUrl}}/connections/{{connectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "{{connectionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Accounting",
      "item": [
        {
