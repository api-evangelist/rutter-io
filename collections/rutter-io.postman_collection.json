            "url": {
              "raw": "{{baseUrl}}/accounting/bills?access_token={{accessToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounting", "bills"],
              "query": [ { "key": "access_token", "value": "{{accessToken}}" } ]
            }
          }
        },
        {
          "name": "List accounting payments",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Rutter-Version", "value": "{{rutterVersion}}" } ],
            "url": {
              "raw": "{{baseUrl}}/accounting/payments?access_token={{accessToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounting", "payments"],
              "query": [ { "key": "access_token", "value": "{{accessToken}}" } ]
